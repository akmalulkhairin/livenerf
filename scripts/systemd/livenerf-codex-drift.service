[Unit]
Description=Advance the LiveNerf Codex drift study on the upstream panel
StartLimitIntervalSec=5h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/livenerf-codex/current
EnvironmentFile=%h/.config/livenerf-codex/environment
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=%h/.local/share/livenerf-codex/current/.venv/bin/python -m livenerf.codex_upstream_study --run
TimeoutStartSec=2h
Restart=on-failure
RestartSec=5min
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
